root = Answer("Hermes records each new skill in its index, and a loader can hand it to the harness.", [f1, t1])
p1 = Part("Skill writer", "a_part", "r1", "Writes the skill folder")
p2 = Part("Skills index", "a_port", "r9:44", "Records each skill")
p3 = Part("Skill loader", "adapter", "", "Wraps skills as tools", "new")
p4 = Part("Tool list", "b_port", "", "What the agent reads")
s1 = Step(1, "Hermes writes a new skill folder.")
s2 = Step(7, "The skill reaches the tool list.")
m1 = Coupling([p1, p2, p3, p4], [s1, s2], "skill → tool")
f1 = Fig("How a skill reaches the harness", m1, "A loader carries skills into the tool list.")
t1 = Snippet("r2:90-99", "Where Hermes records a skill")
