root = Answer("Each batch is checked row by row; a row that fails its schema goes to quarantine instead of the store, so one bad row never blocks the batch.", [f1, k1, t1, w1, c1, x1, n1])
p1 = Part("Batch fetch", "intake", "r1:13", "Pulls one batch from the source")
p2 = Part("Schema check", "station", "r2:25", "Compares each row with the schema")
p3 = Part("Normalizer", "station", "r3", "Trims, lowercases and dates each field")
p4 = Part("Quarantine", "reject", "r4:8", "Keeps the bad row and the reason")
p5 = Part("Row store", "output", "r5:18", "Writes the clean rows")
s1 = Step(1, "A batch of rows comes in from the source.")
s2 = Step(2, "The schema check finds a row with no id.", null, true)
s3 = Step(4, "That row goes to quarantine with its reason.")
s4 = Step(3, "The other rows are normalized.")
s5 = Step(5, "The clean rows are written to the store.")
m1 = Conveyor([p1, p2, p3, p4, p5], [s1, s2, s3, s4, s5], "rows of one batch")
f1 = Fig("One batch through the ingest service", m1, "Rows that fail the schema check leave the line at quarantine; the rest go on to the store.")
k1 = Text("The check runs per row, so **one bad row** costs one quarantine entry, not the whole batch. See `check_row` below.")
t1 = Snippet("r2:16-26", "The per-row check and where it raises")
w1 = Callout("watch", "Quarantine keeps the reason as text; if you change the schema, old reasons won't match new field names.")
c1 = Compare(Side("Current check", "r2", ["Raises on the first bad field", "Reason is a string"]), Side("Draft v2", "r6", ["Collects every bad field", "Reason is a list"]))
x1 = CodeRef("r5:18", "write_rows")
n1 = NewCode([NewItem("ingest_svc/report.py", "Count quarantined rows per batch for the dashboard", "r4")])
