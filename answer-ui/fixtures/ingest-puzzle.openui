root = Answer("Cada lote pasa por la validación: las filas buenas se normalizan y se guardan, y las malas van a cuarentena con su motivo.", [z1, k1, c1, q1])
p1 = Piece("fetch_batch", "r1:13", "function")
p2 = Piece("check_batch", "r2:14", "function")
p3 = Piece("normalize", "r3:4", "function")
p4 = Piece("write_rows", "r5:18", "function")
p5 = Piece("quarantine", "r4:8", "function")
j1 = Joint(p1, p2, "list[Row]")
j2 = Joint(p2, p3, "Checked.good")
j3 = Joint(p3, p4, "cada Row normalizada")
j4 = Joint(p2, p5, "Checked.bad: la fila y su motivo")
s1 = Step(p1, "fetch_batch lee hasta 500 filas de la fuente.")
s2 = Step(p2, "check_batch separa las filas buenas de las malas.")
s3 = Step(j3, "Las buenas se normalizan y write_rows las guarda en una transacción.")
s4 = Step(j4, "Cada fila mala va a quarantine con el motivo del fallo.")
z1 = Puzzle("Un lote por la validación", [p1, p2, p3, p4, p5], [j1, j2, j3, j4], [s1, s2, s3, s4], "La validación decide el camino de cada fila: tabla de filas o cuarentena.")
k1 = Compare(v1, v2)
v1 = Side("check_batch", "r2", ["Separa el lote en buenas y malas", "Devuelve Checked(good, bad)"])
v2 = Side("check_row, en validate_v2", "r6", ["Revisa una sola fila", "Devuelve la lista de problemas"])
c1 = Callout("watch", "Hay dos validaciones: `validate_v2.check_row` revisa una fila y devuelve sus problemas en vez de separar el lote.")
q1 = Check("¿Adónde va una fila a la que le falta un campo obligatorio?", ["A la tabla de filas, vacía", "A cuarentena, con su motivo", "A ninguna parte: se descarta"], 2, "check_batch la deja en Checked.bad, y quarantine la guarda con el motivo.")
