root = Answer("Monta TimedAdapter en la clave \"https://\" de la Session: las peticiones http siguen usando el HTTPAdapter por defecto.", [z1, t1, t2, c1, k1])
p1 = Piece("Session.mount", "d32", "method")
p2 = Piece("Session.adapters", "d10:499-502", "value")
p4 = Piece("Session.send", "d2:778-784", "method")
p3 = NewPiece("TimedAdapter", "requests", "src/requests/timed.py", "d9", "Cronometra send, solo se monta en https")
p5 = Piece("HTTPAdapter.send", "d9", "method")
j1 = Joint(p1, p2, "prefijo \"https://\" y la instancia")
j2 = Joint(p2, p3, "la clave https:// guarda TimedAdapter")
j3 = Joint(p4, p3, "get_adapter(url) devuelve el adaptador")
j4 = Joint(p3, p5, "super().send(request, **kwargs)")
s1 = Step(p1, "mount añade una entrada nueva bajo el prefijo indicado.")
s2 = Step(j1, "El prefijo \"https://\" y tu instancia entran en self.adapters.")
s3 = Step(j2, "http:// y https:// son claves separadas: solo cambia la de https.")
s4 = Step(j3, "En cada envío, get_adapter busca el prefijo más largo que encaje.")
s5 = Step(j4, "TimedAdapter.send cronometra y delega en HTTPAdapter.send.")
z1 = Puzzle("Montar el adaptador solo en https", [p1, p2, p3, p4, p5], [j1, j2, j3, j4], [s1, s2, s3, s4, s5], "Los adaptadores viven en un diccionario por prefijo, así que montar https:// deja intacta la entrada http://.")
t1 = Snippet("d10:499-502", "Los dos adaptadores por defecto, cada uno con su prefijo")
t2 = Snippet("d22:989-994", "Mount por prefijo, tal como lo documenta requests")
c1 = Callout("watch", "Montar \"https://\" sustituye el adaptador https por defecto; con un prefijo de host como \"https://api.example.com/\" limita la medición a ese host.")
x1 = Text("No hace falta tocar `Session.adapters` a mano: `mount(\"https://\", TimedAdapter())` reemplaza solo esa clave y conserva la de `http://`. Gana siempre el prefijo más largo, así que un prefijo con host y barra final es más preciso que el esquema a secas.")
k1 = Check("¿Qué envíos quedan sin cronometrar si montas TimedAdapter en \"https://\"?", ["Los https a otros hosts", "Los http, que siguen con HTTPAdapter", "Ninguno, mount afecta a toda la sesión"], 2, "Solo se sustituye el adaptador de la clave https://; la clave http:// conserva el HTTPAdapter por defecto.")
