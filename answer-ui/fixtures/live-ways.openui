root = Answer("Monta un HTTPAdapter con un Retry(connect=3, backoff_factor=0.5) en tu sesión: adapters ya pasa self.max_retries a urlopen, y urllib3 duerme entre intentos.", [k1, z1, n1])
w1 = Way("HTTPAdapter con Retry y backoff", "sync", "Creas un Retry con connect y backoff_factor, lo pasas como max_retries al HTTPAdapter y lo montas en la sesión.", "bajo", "Solo cubre fallos de conexión y DNS, nunca datos que ya llegaron al servidor.", ["r4:696-709", "r6:388-392"])
w2 = Way("Pasar un entero de reintentos", "wrench", "max_retries=3 deja que Retry.from_int arme el objeto, pero sin backoff_factor los intentos salen seguidos.", "bajo", "Reintenta sin ninguna espera entre intentos.", ["r4:705", "r8:1022-1026"])
w3 = Way("Envolver la llamada en tu código", "flow", "Una función tuya repite la llamada con time.sleep exponencial cuando salta ConnectionError.", "medio", "Repites lo que urllib3 ya hace y tu espera no mira el Retry-After del servidor.", ["r6:394-408"])
k1 = Ways("¿Cómo añado espera a los reintentos?", [w1, w2, w3])
p0 = NewPiece("adapter = HTTPAdapter(max_retries=Retry(connect=3, backoff_factor=0.5))", "requests", "mi_sesion.py", "r4:705", "Se configura una vez por sesión")
p1 = Piece("HTTPAdapter.send", "r4:696-709", "method")
p2 = Piece("HTTPConnectionPool.urlopen", "r5:836-838", "method")
p3 = Piece("Retry.sleep", "r6:394-408", "method")
p4 = Piece("Retry._sleep_backoff", "r6:388-392", "method")
j1 = Joint(p0, p1, "self.max_retries")
j2 = Joint(p1, p2, "retries=self.max_retries")
j3 = Joint(p2, p3, "retries.sleep()")
j4 = Joint(p3, p4, "self._sleep_backoff()")
s1 = Step(p0, "Configuras el adaptador una sola vez, con connect y backoff_factor.")
s2 = Step(j2, "send le pasa tu Retry a urlopen en cada petición.")
s3 = Step(j3, "Al fallar la conexión, urlopen incrementa el contador y llama a sleep.")
s4 = Step(j4, "Sin Retry-After, el backoff crece: 0,5, luego 1, luego 2 segundos.")
z1 = Puzzle("Dónde ocurre la espera entre reintentos", [p0, p1, p2, p3, p4], [j1, j2, j3, j4], [s1, s2, s3, s4], "requests solo transporta el Retry; quien cuenta, duerme y decide volver a intentarlo es urllib3.")
n1 = Next(["¿Qué métodos reintenta urllib3 por defecto?", "¿Cómo respeto la cabecera Retry-After?", "¿Cuánto espera con backoff_factor=1?"])
