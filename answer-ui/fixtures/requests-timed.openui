root = Answer("Envuelve HTTPAdapter.send en un adaptador propio que mida el tiempo alrededor de la llamada, y móntalo en la sesión para https://.", [z1, c1])
p1 = Piece("Session.get_adapter", "r7:870", "method")
p2 = NewPiece("TimedAdapter.send", "requests", "src/requests/timed.py", "r2", "Mide cada envío")
p3 = Piece("HTTPAdapter.send", "r2:696-709", "method")
p4 = Piece("HTTPConnectionPool.urlopen", "r3:782", "method")
j1 = Joint(p1, p2, "el adaptador montado para https://")
j2 = Joint(p2, p3, "super().send(request, **kwargs)")
j3 = Joint(p3, p4, "method, url, body, headers")
s1 = Step(p1, "La sesión elige el adaptador por el prefijo de la URL.")
s2 = Step(p2, "TimedAdapter.send anota la hora y llama al send de siempre.")
s3 = Step(j3, "La petición sigue igual hasta urlopen, ya en urllib3.")
z1 = Puzzle("Dónde encaja un adaptador que mide", [p1, p2, p3, p4], [j1, j2, j3], [s1, s2, s3], "El adaptador nuevo se monta en la sesión y envuelve al de siempre.")
c1 = Callout("note", "Móntalo con `session.mount('https://', TimedAdapter())`: la sesión usa el prefijo más largo que coincide.")
