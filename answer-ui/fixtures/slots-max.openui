root = Answer("A coupling holds up to three parts on each side, and a line up to six stations; past that, split the idea into two figures.", [f1, f2])
p1 = Part("Parser", "a_part", "", "Reads the input", "concept")
p2 = Part("Planner", "a_part", "", "Chooses the steps", "concept")
p3 = Part("Emitter", "a_part", "", "Writes the output", "concept")
p4 = Part("Out port", "a_port", "", "Where A hands off", "concept")
p5 = Part("Contract", "key", "", "The shape both agree on", "concept")
p6 = Part("Adapter", "adapter", "", "Converts between them", "concept")
p7 = Part("In port", "b_port", "", "Where B takes it in", "concept")
p8 = Part("Checker", "b_part", "", "Validates it", "concept")
p9 = Part("Runner", "b_part", "", "Runs it", "concept")
pa = Part("Reporter", "b_part", "", "Reports the result", "concept")
s1 = Step(2, "A plans the work.")
s2 = Step(5, "Both sides agree on the contract.")
s3 = Step(6, "The adapter converts the plan.")
s4 = Step(9, "B runs it.")
m1 = Coupling([p1, p2, p3, p4, p5, p6, p7, p8, p9, pa], [s1, s2, s3, s4], "plan → run")
f1 = Fig("A full coupling", m1, "Three parts in each housing, joined through their ports, the contract and the adapter.")
q1 = Part("Upload", "intake", "", "A new file", "concept")
q2 = Part("Virus scan", "station", "", "Looks for malware", "concept")
q3 = Part("Type check", "station", "", "Confirms the file type", "concept")
q4 = Part("Resize", "station", "", "Makes the sizes", "concept")
q5 = Part("Compress", "station", "", "Shrinks each size", "concept")
q6 = Part("Tag", "station", "", "Adds metadata", "concept")
q7 = Part("Index", "station", "", "Makes it searchable", "concept")
q8 = Part("Blocked", "reject", "", "Files that fail a check", "concept")
q9 = Part("Library", "output", "", "Where finished files live", "concept")
r1 = Step(1, "A file is uploaded.")
r2 = Step(2, "The scan finds nothing.")
r3 = Step(4, "Three sizes are made.")
r4 = Step(7, "The file is indexed.")
r5 = Step(9, "It lands in the library.")
m2 = Conveyor([q1, q2, q3, q4, q5, q6, q7, q8, q9], [r1, r2, r3, r4, r5], "one file")
f2 = Fig("A six-station line", m2, "Every station a file passes, in order, before it reaches the library.")
