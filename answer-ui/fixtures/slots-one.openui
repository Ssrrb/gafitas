root = Answer("With one part on each side, a coupling still needs its two ports and the adapter between them; a one-station line is just intake, work and output.", [f1, f2])
p1 = Part("Producer", "a_part", "", "Makes the event", "concept")
p2 = Part("Out port", "a_port", "", "Where events leave", "concept")
p3 = Part("Adapter", "adapter", "", "Turns one shape into the other", "concept")
p4 = Part("In port", "b_port", "", "Where events arrive", "concept")
p5 = Part("Consumer", "b_part", "", "Uses the event", "concept")
s1 = Step(1, "The producer makes an event.")
s2 = Step(3, "The adapter reshapes it.")
s3 = Step(5, "The consumer uses it.")
m1 = Coupling([p1, p2, p3, p4, p5], [s1, s2, s3], "one event")
f1 = Fig("The smallest coupling", m1, "One part on each side, joined by two ports and an adapter.")
q1 = Part("Job in", "intake", "", "A queued job", "concept")
q2 = Part("Worker", "station", "", "Runs the job", "concept")
q3 = Part("Done", "output", "", "The finished job", "concept")
r1 = Step(1, "A job is taken from the queue.")
r2 = Step(2, "The worker runs it.")
r3 = Step(3, "The job is marked done.")
m2 = Conveyor([q1, q2, q3], [r1, r2, r3], "one job")
f2 = Fig("The smallest line", m2, "Intake, one station and the output.")
